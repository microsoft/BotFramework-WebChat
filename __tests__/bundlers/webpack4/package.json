{
  "name": "@msinternal/botframework-webchat-bundlers-webpack4",
  "version": "0.0.0-0",
  "description": "A Web Chat app bundled with webpack 4, see ../README.md",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "bump": "vg bump prod && vg bump dev && (npm audit fix || exit 0)",
    "react16": "npm install --no-save react@16.8.6 react-dom@16.8.6",
    "react18": "npm install --no-save react@18.3.1 react-dom@18.3.1",
    "react19": "npm install --no-save react@19.3.1 react-dom@19.3.1"
  },
  "pinDependencies": {
    "@babel/core": [
      "7",
      "babel-loader@8 needs Babel 7"
    ],
    "@babel/preset-env": [
      "7",
      "babel-loader@8 needs Babel 7"
    ],
    "babel-loader": [
      "8",
      "babel-loader@9 needs webpack 5"
    ],
    "webpack": [
      "4",
      "this app tests webpack 4"
    ],
    "webpack-cli": [
      "3",
      "webpack-cli@3 is the one from webpack 4's docs"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babel-loader": "8.4.1",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12"
  }
}
