ignore-scripts=true
# Resolve only versions published 7 or more days ago, consumers that install with a minimum release age cannot install newer ones. Needs npm 11.10 or later, older npm warns and ignores it.
# To add a younger version anyway, e.g. a security fix: npm install <name>@<version> --min-release-age=0, then list it in BYPASS of the "Package age" check.
min-release-age=7
