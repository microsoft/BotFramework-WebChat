{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0", // Required for "downlevelIteration" (api, component) in typescript@6
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ESNext"
  }
}
