        "types": "./dist/botframework-webchat-component-carousel.d.mts",
        "default": "./dist/botframework-webchat-component-carousel.mjs"
      },
      "require": {
        "types": "./dist/botframework-webchat-component-carousel.d.ts",
        "default": "./dist/botframework-webchat-component-carousel.js"
      }
    }
  },
