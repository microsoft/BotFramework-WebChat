    "@types/react": "^16.14.70",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">= 16.8.6"
  },
  "dependencies": {
    "valibot": "1.4.1"
  }
}
